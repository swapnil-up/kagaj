    {
      "id": "crime",
      "title": "CID violent-crime panels",
      "status": "active",
      "description": "Structured extraction of the Crime Investigation Department's monthly e-bulletins. Values are read from the vector charts in each bulletin — data labels are the source of truth and bars are used only for baselines and scale checks — then assembled into monthly, national and fiscal-year panels of violent crime.",
      "grain": "one row per month × offence × province (with national and fiscal-year rollups in separate files)",
      "coverage": {
        "start": "2075 Bhadra",
        "end": "2083 Ashoj",
        "note": "Bikram Sambat; 51 of 58 bulletins carry usable province-by-offence charts"
      },
      "sources": [
        {
          "name": "Crime Investigation Department, Nepal Police",
          "url": "https://cid.nepalpolice.gov.np/publication/4/"
        }
      ],
      "verification": {
        "status": "verified",
        "method": "integrity checks over parsed bulletins, province sums reconciled against national tables where both exist, and cross-bulletin revision conflicts recorded rather than smoothed",
        "report": "verify.json"
      },
      "pipeline": {
        "package": "crime",
        "cli": "python -m crime.cli build",
        "plan": "docs/plans/nepal-crime-data.md"
      },
      "license": {
        "code": "MIT",
        "data": "MIT; derived from public Nepal Police bulletins, attribution required"
      },
      "tags": [
        "crime",
        "police",
        "cid",
        "monthly",
        "province"
      ],
      "notes": [
        "Kathmandu Valley is excluded from cross-month comparisons because some source charts omit it.",
        "Months with missing or partial charts are reported as gaps, never as zeros."
      ],
      "docs": [
        "DATASET.md",
