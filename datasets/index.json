      "id": "labour-migration",
      "title": "Labour-migration panel",
      "status": "active",
      "description": "Tidy, audited extraction of the labour-approval tables published by the Department of Foreign Employment: how many Nepalis received work permits, to which country or district, through which channel, in which fiscal year. Every source document is math-audited against its own printed totals before its rows enter the panel.",
      "grain": "one row per source document × reporting period × section (country | district) × entity × channel × gender",
      "coverage": {
        "start": "FY2074/75",
        "end": "FY2082/83",
        "note": "Bikram Sambat fiscal years (Shrawan–Ashad); archive backfill beyond this range is tracked separately in panel_archive_build.json"
      },
      "sources": [
        {
          "name": "Department of Foreign Employment",
          "url": "https://dofe.gov.np"
        }
      ],
      "verification": {
        "status": "verified",
        "method": "per-document math audit of the extracted tables, reconciliation against printed totals, cross-source crosscheck against opendatanepal, gold-page transcription tests",
        "report": "reconciliation.json"
      },
      "pipeline": {
        "package": "migration_parser",
        "cli": "python -m migration_parser.cli build"
      },
