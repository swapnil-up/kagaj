      "id": "translations",
      "title": "Parliament translations",
      "status": "active",
      "description": "House of Representatives notices and National Assembly verbatims, OCR'd from the published PDFs and translated to English by a fixed-schema Gemini call. Each document has raw Devanagari OCR, an English translation, and a structured JSON record (session, sections, speakers, bills, tags).",
      "grain": "one structured JSON record per document",
      "coverage": {
        "start": "6th HoR (archive notices)",
        "end": "7th HoR and NA sessions 19+ (2083)",
        "note": "Verbatims are segmented into 10k-character chunks with checkpoints; only the merged JSON is committed"
      },
      "sources": [
        {
          "name": "House of Representatives secretariat",
          "url": "https://hr.parliament.gov.np"
        },
        {
          "name": "National Assembly verbatims API",
          "url": "https://na.parliament.gov.np/api/v1/verbatims"
        }
      ],
      "verification": {
        "status": "partial",
