{"id": "zwnj-canonical-key", "category": "zwj-zwnj", "rule": "canonical_key.zwnj-stripped", "input": "क्\u200cष", "expected": "क्ष", "source": "docs/devanagari.md", "notes": "canonical_key removes ZWNJ for matching, even though normalize preserves it."}
{"id": "zwj-jnya", "category": "zwj-zwnj", "rule": "normalize.zwj", "input": "ज्\u200dञ", "expected": "ज्\u200dञ", "source": "docs/devanagari.md", "notes": "ZWJ inside ज्ञ requests the half-form rather than the ligature."}
