{"id": "matra-o-logical-split", "category": "matra", "rule": "canonical_key.compose-two-part", "input": "हेा", "expected": "हो", "source": "docs/devanagari.md", "notes": "canonical_key folds the logical two-part sequence U+0947 U+093E to U+094B."}
{"id": "matra-o-visual-split", "category": "matra", "rule": "canonical_key.compose-two-part", "input": "हाे", "expected": "हो", "source": "docs/devanagari.md", "notes": "A visual-order OCR split ा + े has the same canonical key as हो."}
{"id": "matra-au-logical-split", "category": "matra", "rule": "canonical_key.compose-two-part", "input": "हैा", "expected": "हौ", "source": "docs/devanagari.md", "notes": "canonical_key folds U+0948 U+093E to U+094C (ौ)."}
{"id": "matra-au-visual-split", "category": "matra", "rule": "canonical_key.compose-two-part", "input": "हाै", "expected": "हौ", "source": "docs/devanagari.md", "notes": "The visual-order split ा + ै is equivalent to ौ for matching."}
{"id": "matra-i-logical", "category": "matra", "rule": "normalize.matra-i", "input": "कि", "expected": "कि", "source": "docs/devanagari.md", "notes": "ि is stored after क in logical order."}
{"id": "matra-i-visual-invalid", "category": "matra", "rule": "invalid.visual-order-matra", "input": "िक", "expected": "कि", "source": "docs/devanagari.md", "notes": "Leading ि is invalid as logical text; it must follow a consonant."}
{"id": "matra-candra-o", "category": "matra", "rule": "normalize.loanword-matra", "input": "कॉ", "expected": "कॉ", "source": "docs/devanagari.md", "notes": "U+0949 (ॉ) is a valid loanword matra and must survive normalize."}
{"id": "matra-segment-ho", "category": "matra", "rule": "segment.matra", "input": "हो", "expected": "हो", "source": "docs/devanagari.md", "notes": "The matra stays with its consonant: हो is one aksara."}
{"id": "nukta-valid-dda", "category": "nukta", "rule": "normalize.valid-nukta", "input": "खड़ग", "expected": "खड़ग", "source": "datasets/translations/All_works_of_6th_sessions-ocr.txt:82", "notes": "ड़ is ड + nukta. The nukta is phonemic and must not be stripped."}
